            "plon",
            "plat"
          ]
        },
        {
          "calculate": "join(pluck(datum.rows, 'tag'), '; ')",
          "as": "titles"
        },
        {
          "calculate": "indexof(['New South Wales', 'South Australia', 'Northern Territory', 'Queensland', 'Western Australia', 'Tasmania', 'Victoria'], datum.place2) >= 0",
          "as": "isState"
        },
        {
          "calculate": "indexof(['Hobart'], datum.place2) >= 0",
          "as": "side"
        },
        {
          "calculate": "'M0,0L0,' + (-datum.set * 14)",
          "as": "setPath"
        },
        {
          "calculate": "datum.set > 0 && datum.shot > 0 ? 7 : 0",
          "as": "sx"
        },
        {
          "calculate": "'M' + datum.sx + ',0L' + datum.sx + ',' + (-datum.shot * 14)",
          "as": "shotPath"
        },
        {
          "calculate": "datum.isState ? datum.place2 + ' (whole state)' : datum.place2",
          "as": "label"
        },
        {
          "calculate": "datum.place2 == 'Bendigo' ? 'right' : (datum.place2 == 'Hobart' ? 'center' : (datum.place2 == 'Tasmania' ? 'right' : (datum.place2 == 'Jindabyne' ? 'left' : (datum.place2 == 'New South Wales' ? 'right' : ('center')))))",
          "as": "lalign"
        },
        {
          "calculate": "datum.place2 == 'Bendigo' ? -10 : (datum.place2 == 'Hobart' ? 3.5 : (datum.place2 == 'Tasmania' ? -10 : (datum.place2 == 'Jindabyne' ? 10 : (datum.place2 == 'New South Wales' ? -8 : (datum.sx / 2)))))",
          "as": "ldx"
        },
        {
          "calculate": "datum.place2 == 'Bendigo' ? 0 : (datum.place2 == 'Hobart' ? 12 : (datum.place2 == 'Tasmania' ? -7 : (datum.place2 == 'Jindabyne' ? 0 : (datum.place2 == 'New South Wales' ? -12 : (12)))))",
          "as": "ldy"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "baseline": "middle",
        "align": {
          "expr": "datum.lalign"
        },
        "dx": {
          "expr": "datum.ldx"
        },
        "dy": {
          "expr": "datum.ldy"
        },
        "color": {
          "expr": "datum.isState ? '#6B6257' : '#1F1A15'"
        }
      },
      "encoding": {
        "longitude": {
          "field": "plon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "plat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "tooltip": [
          {
            "field": "place2",
            "title": "Place"
          },
          {
            "field": "set",
            "title": "Films set here"
          },
          {
            "field": "shot",
            "title": "Films shot here"
          },
          {
            "field": "titles",
            "title": "Titles"
          }
        ]
      }
    },
