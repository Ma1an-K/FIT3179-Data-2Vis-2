{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where the winning stories are set and shot",
    "subtitle": "Places recorded on Wikidata for Best Film winners, 1969–2025 (Australia only)"
  },
  "width": "container",
  "height": 520,
  "params": [
    {
      "name": "decade",
      "value": "All"
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -27
    ]
  },
  "layer": [
    {
      "data": {
        "url": "js/au_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E5DED2",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/best_film_locations.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.level == 'place' && datum.country == 'Australia' && isValid(datum.lon) && isValid(datum.lat)"
        },
        {
          "filter": "decade == 'All' || floor(datum.year / 10) * 10 + 's' == decade"
        },
        {
          "calculate": "datum.place == 'Docklands Studios Melbourne' ? 'Melbourne' : (datum.place == 'Disney Studios Australia' || datum.place == 'Centennial Park Cemetery') ? 'Sydney' : datum.place",
          "as": "place2"
        },
        {
          "calculate": "datum.place2 == 'Melbourne' ? 144.963 : datum.place2 == 'Sydney' ? 151.21 : datum.place2 == 'Tasmania' ? 146.4 : datum.lon",
          "as": "plon"
        },
        {
          "calculate": "datum.place2 == 'Melbourne' ? -37.814 : datum.place2 == 'Sydney' ? -33.868 : datum.lat",
          "as": "plat"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "place2",
            "plon",
            "plat",
            "kind",
            "film",
            "year"
          ]
        },
        {
          "calculate": "datum.kind == 'setting' ? 1 : 0",
          "as": "isSet"
        },
        {
          "calculate": "datum.kind == 'filming' ? 1 : 0",
          "as": "isShot"
        },
        {
          "calculate": "(datum.kind == 'setting' ? 'set: ' : 'shot: ') + datum.film + ' (' + datum.year + ')'",
          "as": "tag"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "isSet",
              "as": "set"
            },
            {
              "op": "sum",
              "field": "isShot",
              "as": "shot"
            },
            {
              "op": "values",
              "as": "rows"
            }
          ],
          "groupby": [
            "place2",
            "plon",
            "plat"
          ]
        },
        {
          "calculate": "join(pluck(datum.rows, 'tag'), '; ')",
          "as": "titles"
        },
        {
          "calculate": "indexof(['New South Wales', 'South Australia', 'Northern Territory', 'Queensland', 'Western Australia', 'Tasmania', 'Victoria'], datum.place2) >= 0",
          "as": "isState"
        },
        {
          "calculate": "indexof(['Hobart'], datum.place2) >= 0",
          "as": "side"
        },
        {
          "calculate": "'M0,0L0,' + (-datum.set * 14)",
          "as": "setPath"
        },
        {
          "calculate": "datum.set > 0 && datum.shot > 0 ? 7 : 0",
          "as": "sx"
        },
        {
          "calculate": "'M' + datum.sx + ',0L' + datum.sx + ',' + (-datum.shot * 14)",
          "as": "shotPath"
        },
        {
          "filter": "datum.set > 0"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "size": 4,
        "opacity": 1,
        "stroke": "#B8892A",
        "strokeWidth": 5,
        "strokeCap": "butt"
      },
      "encoding": {
        "longitude": {
          "field": "plon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "plat",
          "type": "quantitative"
        },
        "shape": {
          "field": "setPath",
          "type": "nominal",
          "scale": null
        },
        "opacity": {
          "condition": {
            "test": "datum.isState",
            "value": 0.5
          },
          "value": 1
        },
        "tooltip": [
          {
            "field": "place2",
            "title": "Place"
          },
          {
            "field": "set",
            "title": "Films set here"
          },
          {
            "field": "shot",
            "title": "Films shot here"
          },
          {
            "field": "titles",
            "title": "Titles"
          }
        ]
      }
    },
