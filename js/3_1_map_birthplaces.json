          "mark": {
            "type": "point",
            "filled": true,
            "size": 4,
            "shape": "M-3.5,0a3.5,3.5 0 1,0 7.0,0a3.5,3.5 0 1,0 -7.0,0Z",
            "color": "#6A5F55",
