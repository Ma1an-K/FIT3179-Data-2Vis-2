              "mark": {
                "type": "circle",
                "opacity": 0.9,
                "stroke": "#FFFFFF",
                "strokeWidth": 1
              },
              "encoding": {
                "longitude": {
                  "field": "plon",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "plat",
                  "type": "quantitative"
                },
                "size": {
                  "field": "wins",
                  "type": "quantitative",
                  "scale": {
                    "domain": [
                      1,
                      10
                    ],
                    "range": [
                      40,
                      900
                    ]
                  },
                  "legend": null
                },
                "order": {
                  "field": "wins",
                  "sort": "descending"
                },
                "color": {
                  "field": "origin",
                  "type": "nominal",
                  "legend": null,
                  "scale": {
                    "domain": [
                      "Australia",
                      "Overseas"
                    ],
                    "range": [
                      "#B5431F",
                      "#2F5D50"
                    ]
                  }
                },
                "tooltip": [
                  {
                    "field": "place",
                    "title": "Born"
                  },
                  {
                    "field": "birth_country",
                    "title": "Country"
                  },
                  {
                    "field": "wins",
                    "type": "quantitative",
                    "title": "Best Film wins"
                  },
                  {
                    "field": "directors",
                    "title": "Directors"
                  }
                ]
              }
            },
            {
              "data": {
                "url": "data/best_film_directors.csv",
                "format": {
                  "type": "csv",
                  "parse": {
                    "year": "number",
                    "lon": "number",
                    "lat": "number"
                  }
                }
              },
              "transform": [
                {
                  "filter": "datum.lon < -30"
                },
                {
                  "filter": "isValid(datum.lon) && isValid(datum.lat)"
                },
                {
                  "filter": "decade == 'All' || floor(datum.year / 10) * 10 + 's' == decade"
                },
                {
                  "calculate": "datum.birthplace == 'Melbourne' || datum.birthplace == 'Richmond' ? 'Greater Melbourne' : (datum.birthplace == 'Sydney' || datum.birthplace == 'Camden' || datum.birthplace == 'Paddington' ? 'Greater Sydney' : (datum.birthplace == 'Adelaide' || datum.birthplace == 'Gawler' ? 'Greater Adelaide' : (datum.birthplace == 'Strathmore Park' ? 'Wellington' : datum.birthplace)))",
                  "as": "place"
                },
                {
                  "calculate": "datum.place == 'Greater Melbourne' ? 144.963055555 : (datum.place == 'Greater Sydney' ? 151.21 : (datum.place == 'Greater Adelaide' ? 138.6 : (datum.place == 'Wellington' ? 174.777222222 : datum.lon)))",
                  "as": "plon"
                },
                {
                  "calculate": "datum.place == 'Greater Melbourne' ? -37.814166666 : (datum.place == 'Greater Sydney' ? -33.867777777 : (datum.place == 'Greater Adelaide' ? -34.9275 : (datum.place == 'Wellington' ? -41.288888888 : datum.lat)))",
                  "as": "plat"
                },
                {
                  "aggregate": [
                    {
                      "op": "count",
                      "as": "n_dir"
                    }
                  ],
                  "groupby": [
                    "place",
                    "plon",
                    "plat",
                    "birth_country",
                    "director"
                  ]
                },
                {
                  "aggregate": [
                    {
                      "op": "sum",
                      "field": "n_dir",
                      "as": "wins"
                    },
                    {
                      "op": "values",
                      "field": "director",
                      "as": "dir_rows"
                    }
                  ],
                  "groupby": [
                    "place",
                    "plon",
                    "plat",
                    "birth_country"
                  ]
                },
                {
                  "calculate": "join(pluck(datum.dir_rows, 'director'), ', ')",
                  "as": "directors"
                },
                {
                  "calculate": "datum.birth_country == 'Australia' ? 'Australia' : 'Overseas'",
                  "as": "origin"
                },
                {
                  "calculate": "datum.place + ' · ' + datum.wins",
                  "as": "label"
                },
                {
                  "calculate": "datum.place == 'Greytown' ? -9 : (datum.place == 'Wellington' ? 5 : (datum.place == 'Greater Melbourne' ? 13 : (datum.place == 'London' ? -12 : 0)))",
                  "as": "ldy"
                },
                {
                  "calculate": "indexof(['Greater Adelaide', 'Griffith', 'London', 'Hartley Wintney', 'Peekskill'], datum.place) >= 0 ? 'right' : 'left'",
                  "as": "lalign"
                },
                {
                  "calculate": "(datum.lalign == 'left' ? 1 : -1) * (sqrt((40 + (datum.wins - 1) * 860 / 9) / PI) * (datum.ldy == 0 ? 1 : 0.7) + 5)",
                  "as": "ldx"
                }
              ],
              "mark": {
                "type": "text",
                "fontSize": 11,
                "color": "#1E1A14",
                "baseline": "middle",
                "align": {
                  "expr": "datum.lalign"
                },
                "dx": {
                  "expr": "datum.ldx"
                },
                "dy": {
                  "expr": "datum.ldy"
                }
              },
              "encoding": {
                "longitude": {
                  "field": "plon",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "plat",
                  "type": "quantitative"
                },
                "text": {
                  "field": "label"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "size": "independent"
    },
    "legend": {
      "size": "independent"
    }
  }
}
