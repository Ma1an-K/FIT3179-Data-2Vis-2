{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where the directors were born",
    "subtitle": "One dot per Best Film win, placed at the winning director's birthplace; ochre = born in Australia, green = born overseas",
    "offset": 14
  },
  "params": [
    {
      "name": "decade",
      "value": "All"
    }
  ],
  "spacing": 12,
  "vconcat": [
    {
      "title": {
        "text": "Born in Australia and New Zealand",
        "fontSize": 13,
        "anchor": "start"
      },
      "width": 925,
      "height": 440,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -150,
          0,
          0
        ],
        "center": [
          0,
          -30
        ],
        "scale": 640,
        "translate": [
          462.5,
          220.0
        ]
      },
      "layer": [
        {
          "data": {
            "sphere": true
          },
          "mark": {
            "type": "geoshape",
            "fill": "#E2E9E6",
            "stroke": null,
            "clip": true
          }
        },
        {
          "data": {
            "url": "js/ne_110m_admin_0_countries.topojson",
            "format": {
              "type": "topojson",
              "feature": "ne_110m_admin_0_countries"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#EDE3D3",
            "stroke": "#DDD3C6",
            "strokeWidth": 0.6,
            "clip": true
          },
          "transform": [
            {
              "filter": "datum.properties.NAME != 'Australia'"
            }
          ]
        },
        {
          "data": {
            "url": "js/au_states.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#EDE3D3",
            "stroke": "#FFFFFF",
            "strokeWidth": 1,
            "clip": true
          }
        },
        {
          "data": {
            "url": "data/best_film_directors.csv",
            "format": {
              "type": "csv",
              "parse": {
                "year": "number",
                "lon": "number",
                "lat": "number"
              }
            }
          },
          "transform": [
            {
              "filter": "datum.birth_country == 'Australia' || datum.birth_country == 'New Zealand'"
            },
            {
              "filter": "isValid(datum.lon) && isValid(datum.lat)"
            },
            {
              "filter": "decade == 'All' || floor(datum.year / 10) * 10 + 's' == decade"
            },
            {
              "calculate": "datum.birthplace == 'Richmond' ? 'Melbourne' : (datum.birthplace == 'Paddington' ? 'Sydney' : (datum.birthplace == 'Camden' ? 'Sydney' : (datum.birthplace == 'Gawler' ? 'Adelaide' : (datum.birthplace == 'Strathmore Park' ? 'Wellington' : (datum.birthplace == 'Greytown' ? 'Wellington' : (datum.birthplace == 'Hartley Wintney' ? 'London' : (datum.birthplace == 'Temora' ? 'Griffith' : (datum.birthplace))))))))",
              "as": "group"
            },
            {
              "calculate": "datum.birthplace == datum.group ? 0 : 1",
              "as": "member"
            },
            {
              "joinaggregate": [
                {
                  "op": "count",
                  "as": "gsize"
                }
              ],
              "groupby": [
                "group"
              ]
            },
            {
              "window": [
                {
                  "op": "row_number",
                  "as": "i"
                },
                {
                  "op": "first_value",
                  "field": "lon",
                  "as": "glon"
                },
                {
                  "op": "first_value",
                  "field": "lat",
                  "as": "glat"
                }
              ],
              "groupby": [
                "group"
              ],
              "sort": [
                {
                  "field": "member"
                },
                {
                  "field": "birthplace"
                },
                {
                  "field": "year"
                }
              ],
              "frame": [
                null,
                null
              ]
            },
            {
              "calculate": "min(datum.gsize, 3)",
              "as": "cols"
            },
            {
              "calculate": "((datum.i - 1) % 3 - (datum.cols - 1) / 2) * 8",
              "as": "px"
            },
            {
              "calculate": "floor((datum.i - 1) / 3) * 8",
              "as": "py"
            },
            {
              "calculate": "'M' + (datum.px - 3.5) + ',' + datum.py + 'a3.5,3.5 0 1,0 7.0,0a3.5,3.5 0 1,0 -7.0,0Z'",
              "as": "dot"
            }
          ],
          "mark": {
            "type": "point",
            "filled": true,
            "size": 4,
            "opacity": 1,
            "stroke": "#FFFFFF",
            "strokeWidth": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "glon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "glat",
              "type": "quantitative"
            },
            "shape": {
              "field": "dot",
              "type": "nominal",
              "scale": null
            },
            "color": {
              "condition": {
                "test": "datum.birth_country == 'Australia'",
                "value": "#B5431F"
              },
              "value": "#2F5D50"
            },
            "tooltip": [
              {
                "field": "director",
                "title": "Director"
              },
              {
                "field": "film",
                "title": "Film"
              },
              {
                "field": "year",
                "title": "Year"
              },
              {
                "field": "birthplace",
                "title": "Born"
              },
              {
                "field": "birth_country",
                "title": "Country"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/best_film_directors.csv",
            "format": {
