{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Over a third of winning directors were born in Greater Sydney or Greater Melbourne",
    "subtitle": [
      "A dot map: one dot per Best Film win, placed at the winning director's birthplace; ochre = born in Australia, green = born overseas.",
      "Suburbs and nearby towns are merged into their city (Greater Sydney, Greater Melbourne, Greater Adelaide, Wellington)."
    ],
    "offset": 14
  },
  "params": [
    {
      "name": "decade",
      "value": "All"
    }
  ],
  "spacing": 12,
  "vconcat": [
    {
      "title": {
        "text": "Born in Australia and New Zealand",
        "fontSize": 13,
        "anchor": "start"
      },
      "width": 925,
      "height": 370,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -150,
          0,
          0
        ],
        "center": [
          0,
          -30
        ],
        "scale": 545,
        "translate": [
          462.5,
          185
        ]
      },
      "layer": [
        {
          "data": {
            "sphere": true
          },
          "mark": {
            "type": "geoshape",
            "fill": "#E2E9E6",
            "stroke": null,
            "clip": true
          }
        },
        {
          "data": {
            "url": "js/ne_110m_admin_0_countries.topojson",
            "format": {
              "type": "topojson",
              "feature": "ne_110m_admin_0_countries"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#EDE3D3",
            "stroke": "#DDD3C6",
            "strokeWidth": 0.6,
            "clip": true
          },
          "transform": [
            {
              "filter": "datum.properties.NAME != 'Australia'"
            }
          ]
        },
        {
          "data": {
            "url": "js/au_states.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#EDE3D3",
            "stroke": "#FFFFFF",
            "strokeWidth": 1,
            "clip": true
          }
        },
        {
          "data": {
            "url": "data/best_film_directors.csv",
            "format": {
              "type": "csv",
              "parse": {
                "year": "number",
                "lon": "number",
                "lat": "number"
              }
            }
          },
          "transform": [
            {
              "filter": "datum.birth_country == 'Australia' || datum.birth_country == 'New Zealand'"
            },
            {
              "filter": "isValid(datum.lon) && isValid(datum.lat)"
            },
            {
              "filter": "decade == 'All' || floor(datum.year / 10) * 10 + 's' == decade"
            },
            {
              "calculate": "datum.birthplace == 'Melbourne' || datum.birthplace == 'Richmond' ? 'Greater Melbourne' : (datum.birthplace == 'Sydney' || datum.birthplace == 'Camden' || datum.birthplace == 'Paddington' ? 'Greater Sydney' : (datum.birthplace == 'Adelaide' || datum.birthplace == 'Gawler' ? 'Greater Adelaide' : (datum.birthplace == 'Strathmore Park' ? 'Wellington' : datum.birthplace)))",
              "as": "place"
            },
            {
              "calculate": "datum.place == 'Greater Melbourne' ? 144.963055555 : (datum.place == 'Greater Sydney' ? 151.21 : (datum.place == 'Greater Adelaide' ? 138.6 : (datum.place == 'Wellington' ? 174.777222222 : datum.lon)))",
              "as": "plon"
            },
            {
              "calculate": "datum.place == 'Greater Melbourne' ? -37.814166666 : (datum.place == 'Greater Sydney' ? -33.867777777 : (datum.place == 'Greater Adelaide' ? -34.9275 : (datum.place == 'Wellington' ? -41.288888888 : datum.lat)))",
              "as": "plat"
            },
            {
              "window": [
                {
                  "op": "row_number",
                  "as": "i"
                }
              ],
              "groupby": [
                "place"
              ],
              "sort": [
                {
                  "field": "year"
                },
                {
                  "field": "director"
                }
              ]
            },
            {
              "joinaggregate": [
                {
                  "op": "count",
                  "as": "gsize"
                }
              ],
              "groupby": [
                "place"
              ]
            },
            {
              "calculate": "min(3, ceil(sqrt(datum.gsize)))",
              "as": "cols"
            },
            {
              "calculate": "ceil(datum.gsize / datum.cols)",
              "as": "rows"
            },
            {
              "calculate": "datum.place == 'London' ? 8 : (datum.place == 'Greater Melbourne' ? -6 : 0)",
              "as": "ox"
            },
            {
              "calculate": "datum.place == 'London' ? -8 : (datum.place == 'Greater Melbourne' ? 5 : 0)",
              "as": "oy"
            },
            {
              "calculate": "datum.ox + ((datum.i - 1) % datum.cols - (datum.cols - 1) / 2) * 8",
              "as": "px"
            },
            {
              "calculate": "datum.oy + floor((datum.i - 1) / datum.cols) * 8",
              "as": "py"
            },
            {
              "calculate": "'M' + (datum.px - 3.5) + ',' + datum.py + 'a3.5,3.5 0 1,0 7.0,0a3.5,3.5 0 1,0 -7.0,0Z'",
              "as": "dot"
            }
          ],
          "mark": {
            "type": "point",
            "filled": true,
            "size": 4,
            "opacity": 1,
            "stroke": "#FFFFFF",
            "strokeWidth": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "plon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "plat",
              "type": "quantitative"
            },
            "shape": {
              "field": "dot",
              "type": "nominal",
              "scale": null
            },
            "color": {
              "condition": {
                "test": "datum.birth_country == 'Australia'",
                "value": "#B5431F"
              },
              "value": "#2F5D50"
            },
            "tooltip": [
              {
                "field": "director",
                "title": "Director"
              },
              {
                "field": "film",
                "title": "Film"
              },
              {
                "field": "year",
                "title": "Year"
              },
              {
                "field": "birthplace",
                "title": "Born"
              },
              {
                "field": "place",
                "title": "Counted with"
              },
              {
                "field": "birth_country",
                "title": "Country"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/best_film_directors.csv",
            "format": {
              "type": "csv",
              "parse": {
                "year": "number",
                "lon": "number",
                "lat": "number"
              }
            }
          },
          "transform": [
            {
              "filter": "datum.birth_country == 'Australia' || datum.birth_country == 'New Zealand'"
            },
            {
              "filter": "isValid(datum.lon) && isValid(datum.lat)"
            },
            {
              "filter": "decade == 'All' || floor(datum.year / 10) * 10 + 's' == decade"
            },
            {
              "calculate": "datum.birthplace == 'Melbourne' || datum.birthplace == 'Richmond' ? 'Greater Melbourne' : (datum.birthplace == 'Sydney' || datum.birthplace == 'Camden' || datum.birthplace == 'Paddington' ? 'Greater Sydney' : (datum.birthplace == 'Adelaide' || datum.birthplace == 'Gawler' ? 'Greater Adelaide' : (datum.birthplace == 'Strathmore Park' ? 'Wellington' : datum.birthplace)))",
              "as": "place"
            },
            {
              "calculate": "datum.place == 'Greater Melbourne' ? 144.963055555 : (datum.place == 'Greater Sydney' ? 151.21 : (datum.place == 'Greater Adelaide' ? 138.6 : (datum.place == 'Wellington' ? 174.777222222 : datum.lon)))",
              "as": "plon"
            },
            {
              "calculate": "datum.place == 'Greater Melbourne' ? -37.814166666 : (datum.place == 'Greater Sydney' ? -33.867777777 : (datum.place == 'Greater Adelaide' ? -34.9275 : (datum.place == 'Wellington' ? -41.288888888 : datum.lat)))",
              "as": "plat"
            },
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "n_dir"
                }
              ],
              "groupby": [
                "place",
                "plon",
                "plat",
                "birth_country",
                "director"
              ]
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "n_dir",
                  "as": "wins"
                },
                {
                  "op": "values",
                  "field": "director",
                  "as": "dir_rows"
                }
              ],
              "groupby": [
                "place",
                "plon",
                "plat",
                "birth_country"
              ]
            },
            {
              "calculate": "join(pluck(datum.dir_rows, 'director'), ', ')",
              "as": "directors"
            },
            {
              "calculate": "datum.birth_country == 'Australia' ? 'Australia' : 'Overseas'",
              "as": "origin"
            },
            {
              "filter": "datum.wins >= 2 || datum.birth_country == 'New Zealand'"
            },
            {
              "calculate": "datum.place + ' · ' + datum.wins",
              "as": "label"
            },
            {
              "calculate": "min(3, ceil(sqrt(datum.wins)))",
              "as": "cols"
            },
            {
              "calculate": "ceil(datum.wins / datum.cols)",
              "as": "rows"
            },
            {
              "calculate": "datum.place == 'London' ? 8 : (datum.place == 'Greater Melbourne' ? -6 : 0)",
              "as": "ox"
            },
            {
              "calculate": "datum.place == 'London' ? -8 : (datum.place == 'Greater Melbourne' ? 5 : 0)",
              "as": "oy"
            },
            {
              "calculate": "indexof(['Griffith', 'London'], datum.place) >= 0 ? 'center' : (indexof(['Greater Adelaide', 'Greater Melbourne', 'Hartley Wintney', 'Peekskill'], datum.place) >= 0 ? 'right' : 'left')",
              "as": "lalign"
            },
            {
              "calculate": "datum.ox + (datum.lalign == 'center' ? 0 : (datum.lalign == 'left' ? 1 : -1) * ((datum.cols - 1) / 2 * 8 + 3.5 + 5))",
              "as": "ldx"
            },
            {
              "calculate": "datum.oy + (datum.lalign == 'center' ? -12 : (datum.rows - 1) / 2 * 8 + (datum.place == 'Greytown' ? -9 : (datum.place == 'Wellington' ? 5 : 0)))",
              "as": "ldy"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 11,
            "color": "#1E1A14",
            "baseline": "middle",
            "align": {
              "expr": "datum.lalign"
            },
            "dx": {
              "expr": "datum.ldx"
            },
            "dy": {
              "expr": "datum.ldy"
            }
          },
          "encoding": {
            "longitude": {
              "field": "plon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "plat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
