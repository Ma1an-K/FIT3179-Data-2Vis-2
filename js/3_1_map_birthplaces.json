            },
            {
              "window": [
                {
                  "op": "row_number",
                  "as": "i"
                },
                {
                  "op": "first_value",
                  "field": "lon",
                  "as": "glon"
                },
                {
                  "op": "first_value",
                  "field": "lat",
                  "as": "glat"
                }
              ],
              "groupby": [
                "group"
              ],
              "sort": [
                {
                  "field": "member"
                },
                {
                  "field": "birthplace"
                },
                {
                  "field": "year"
                }
              ],
              "frame": [
                null,
                null
              ]
            },
            {
              "calculate": "min(datum.gsize, 3)",
              "as": "cols"
            },
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "n"
                }
              ],
              "groupby": [
                "birthplace",
                "birth_country",
                "group",
                "member",
                "glon",
                "glat",
                "cols",
                "gsize"
              ]
            },
            {
              "window": [
                {
                  "op": "row_number",
                  "as": "k"
                }
              ],
              "groupby": [
                "group"
              ],
              "sort": [
                {
                  "field": "member"
                },
                {
                  "field": "birthplace"
                }
              ]
            },
            {
              "filter": "datum.n >= 2 || datum.birth_country == 'New Zealand' || datum.gsize > datum.n"
            },
            {
              "calculate": "datum.birthplace + ' · ' + datum.n",
              "as": "label"
            },
            {
              "calculate": "datum.birthplace == 'Melbourne' ? 'right' : (datum.birthplace == 'Richmond' ? 'right' : (datum.birthplace == 'Adelaide' ? 'right' : (datum.birthplace == 'Gawler' ? 'right' : (datum.birthplace == 'Griffith' ? 'right' : (datum.birthplace == 'London' ? 'right' : (datum.birthplace == 'Hartley Wintney' ? 'right' : (datum.birthplace == 'Peekskill' ? 'right' : (datum.birthplace == 'Temora' ? 'right' : ('left')))))))))",
              "as": "lalign"
            },
            {
              "calculate": "(datum.lalign == 'left' ? 1 : -1) * ((datum.cols - 1) / 2 * 8 + 3.5 + 12) + (datum.birthplace == 'Melbourne' ? 0 : (datum.birthplace == 'Richmond' ? 0 : (datum.birthplace == 'Adelaide' ? 0 : (datum.birthplace == 'Gawler' ? 0 : (datum.birthplace == 'Griffith' ? 0 : (datum.birthplace == 'London' ? 0 : (datum.birthplace == 'Hartley Wintney' ? 0 : (datum.birthplace == 'Peekskill' ? 0 : (datum.birthplace == 'Temora' ? 0 : (0))))))))))",
              "as": "ldx"
            },
            {
              "calculate": "(datum.k - 1) * 13 + (datum.birthplace == 'Melbourne' ? 0 : (datum.birthplace == 'Richmond' ? 0 : (datum.birthplace == 'Adelaide' ? 0 : (datum.birthplace == 'Gawler' ? 0 : (datum.birthplace == 'Griffith' ? -13 : (datum.birthplace == 'London' ? 0 : (datum.birthplace == 'Hartley Wintney' ? 0 : (datum.birthplace == 'Peekskill' ? 0 : (datum.birthplace == 'Temora' ? -13 : (0))))))))))",
              "as": "ldy"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 11,
            "color": "#1E1A14",
            "baseline": "middle",
            "align": {
              "expr": "datum.lalign"
            },
            "dx": {
              "expr": "datum.ldx"
            },
            "dy": {
              "expr": "datum.ldy"
            }
