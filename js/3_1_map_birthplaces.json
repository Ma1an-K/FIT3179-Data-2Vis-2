{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where the directors were born",
    "subtitle": "One circle per birthplace, sized by the number of Best Film wins; ochre = born in Australia, green = born overseas. Nearby suburbs are grouped with their city.",
    "offset": 14
  },
  "params": [
    {
      "name": "decade",
      "value": "All"
    }
  ],
  "spacing": 12,
  "vconcat": [
    {
      "title": {
        "text": "Born in Australia and New Zealand",
        "fontSize": 13,
        "anchor": "start"
      },
      "width": 925,
      "height": 440,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -150,
          0,
          0
        ],
        "center": [
          0,
          -30
        ],
        "scale": 640,
        "translate": [
          462.5,
          220.0
        ]
      },
      "layer": [
        {
          "data": {
            "sphere": true
          },
          "mark": {
            "type": "geoshape",
            "fill": "#E2E9E6",
            "stroke": null,
            "clip": true
          }
        },
        {
          "data": {
            "url": "js/ne_110m_admin_0_countries.topojson",
            "format": {
              "type": "topojson",
              "feature": "ne_110m_admin_0_countries"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#EDE3D3",
            "stroke": "#DDD3C6",
            "strokeWidth": 0.6,
            "clip": true
          },
          "transform": [
            {
              "filter": "datum.properties.NAME != 'Australia'"
            }
          ]
        },
        {
          "data": {
            "url": "js/au_states.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#EDE3D3",
            "stroke": "#FFFFFF",
            "strokeWidth": 1,
            "clip": true
          }
        },
        {
          "data": {
            "url": "data/best_film_directors.csv",
            "format": {
              "type": "csv",
              "parse": {
                "year": "number",
                "lon": "number",
                "lat": "number"
              }
            }
          },
          "transform": [
            {
              "filter": "datum.birth_country == 'Australia' || datum.birth_country == 'New Zealand'"
            },
            {
              "filter": "isValid(datum.lon) && isValid(datum.lat)"
            },
            {
              "filter": "decade == 'All' || floor(datum.year / 10) * 10 + 's' == decade"
            },
            {
              "calculate": "datum.birthplace == 'Melbourne' || datum.birthplace == 'Richmond' ? 'Greater Melbourne' : (datum.birthplace == 'Sydney' || datum.birthplace == 'Camden' || datum.birthplace == 'Paddington' ? 'Greater Sydney' : (datum.birthplace == 'Adelaide' || datum.birthplace == 'Gawler' ? 'Greater Adelaide' : (datum.birthplace == 'Strathmore Park' ? 'Wellington' : datum.birthplace)))",
              "as": "place"
            },
            {
              "calculate": "datum.place == 'Greater Melbourne' ? 144.963055555 : (datum.place == 'Greater Sydney' ? 151.21 : (datum.place == 'Greater Adelaide' ? 138.6 : (datum.place == 'Wellington' ? 174.777222222 : datum.lon)))",
              "as": "plon"
            },
            {
              "calculate": "datum.place == 'Greater Melbourne' ? -37.814166666 : (datum.place == 'Greater Sydney' ? -33.867777777 : (datum.place == 'Greater Adelaide' ? -34.9275 : (datum.place == 'Wellington' ? -41.288888888 : datum.lat)))",
              "as": "plat"
            },
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "n_dir"
                }
              ],
              "groupby": [
                "place",
                "plon",
                "plat",
                "birth_country",
                "director"
              ]
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "n_dir",
                  "as": "wins"
                },
                {
                  "op": "values",
                  "field": "director",
                  "as": "dir_rows"
                }
              ],
              "groupby": [
                "place",
                "plon",
                "plat",
                "birth_country"
              ]
            },
            {
              "calculate": "join(pluck(datum.dir_rows, 'director'), ', ')",
              "as": "directors"
            },
            {
              "calculate": "datum.birth_country == 'Australia' ? 'Australia' : 'Overseas'",
              "as": "origin"
            }
          ],
          "mark": {
            "type": "circle",
            "opacity": 0.9,
            "stroke": "#FFFFFF",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "plon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "plat",
              "type": "quantitative"
            },
            "size": {
              "field": "wins",
              "type": "quantitative",
              "scale": {
                "domain": [
                  1,
                  10
                ],
                "range": [
                  40,
                  900
                ]
              },
              "legend": {
                "title": "Best Film wins",
                "values": [
                  1,
                  3,
                  5,
                  10
                ],
                "orient": "bottom-right",
                "symbolType": "circle",
                "fillColor": "#F7F2EA",
                "padding": 8,
                "symbolFillColor": "#9A8C7E",
                "symbolStrokeColor": "#FFFFFF",
                "symbolStrokeWidth": 1,
                "symbolOpacity": 0.9
              }
            },
            "order": {
              "field": "wins",
              "sort": "descending"
            },
            "color": {
              "field": "origin",
              "type": "nominal",
              "legend": null,
              "scale": {
                "domain": [
                  "Australia",
                  "Overseas"
                ],
                "range": [
                  "#B5431F",
                  "#2F5D50"
                ]
              }
            },
            "tooltip": [
              {
                "field": "place",
                "title": "Born"
              },
              {
                "field": "birth_country",
                "title": "Country"
              },
              {
                "field": "wins",
                "type": "quantitative",
                "title": "Best Film wins"
              },
              {
                "field": "directors",
                "title": "Directors"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/best_film_directors.csv",
            "format": {
              "type": "csv",
              "parse": {
                "year": "number",
                "lon": "number",
                "lat": "number"
              }
            }
          },
          "transform": [
            {
              "filter": "datum.birth_country == 'Australia' || datum.birth_country == 'New Zealand'"
            },
            {
              "filter": "isValid(datum.lon) && isValid(datum.lat)"
            },
            {
              "filter": "decade == 'All' || floor(datum.year / 10) * 10 + 's' == decade"
            },
            {
              "calculate": "datum.birthplace == 'Melbourne' || datum.birthplace == 'Richmond' ? 'Greater Melbourne' : (datum.birthplace == 'Sydney' || datum.birthplace == 'Camden' || datum.birthplace == 'Paddington' ? 'Greater Sydney' : (datum.birthplace == 'Adelaide' || datum.birthplace == 'Gawler' ? 'Greater Adelaide' : (datum.birthplace == 'Strathmore Park' ? 'Wellington' : datum.birthplace)))",
              "as": "place"
            },
            {
              "calculate": "datum.place == 'Greater Melbourne' ? 144.963055555 : (datum.place == 'Greater Sydney' ? 151.21 : (datum.place == 'Greater Adelaide' ? 138.6 : (datum.place == 'Wellington' ? 174.777222222 : datum.lon)))",
              "as": "plon"
            },
            {
              "calculate": "datum.place == 'Greater Melbourne' ? -37.814166666 : (datum.place == 'Greater Sydney' ? -33.867777777 : (datum.place == 'Greater Adelaide' ? -34.9275 : (datum.place == 'Wellington' ? -41.288888888 : datum.lat)))",
              "as": "plat"
            },
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "n_dir"
                }
              ],
              "groupby": [
                "place",
                "plon",
                "plat",
                "birth_country",
                "director"
              ]
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "n_dir",
                  "as": "wins"
                },
                {
                  "op": "values",
                  "field": "director",
                  "as": "dir_rows"
                }
              ],
              "groupby": [
                "place",
                "plon",
                "plat",
                "birth_country"
              ]
            },
            {
              "calculate": "join(pluck(datum.dir_rows, 'director'), ', ')",
              "as": "directors"
            },
            {
              "calculate": "datum.birth_country == 'Australia' ? 'Australia' : 'Overseas'",
              "as": "origin"
            },
            {
              "filter": "datum.wins >= 2 || datum.birth_country == 'New Zealand'"
            },
            {
              "calculate": "datum.place + ' · ' + datum.wins",
              "as": "label"
            },
            {
              "calculate": "datum.place == 'Greytown' ? -9 : (datum.place == 'Wellington' ? 5 : (datum.place == 'Greater Melbourne' ? 13 : (datum.place == 'London' ? -12 : 0)))",
              "as": "ldy"
            },
            {
              "calculate": "indexof(['Greater Adelaide', 'Griffith', 'London', 'Hartley Wintney', 'Peekskill'], datum.place) >= 0 ? 'right' : 'left'",
              "as": "lalign"
            },
            {
              "calculate": "(datum.lalign == 'left' ? 1 : -1) * (sqrt((40 + (datum.wins - 1) * 860 / 9) / PI) * (datum.ldy == 0 ? 1 : 0.7) + 5)",
              "as": "ldx"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 11,
            "color": "#1E1A14",
            "baseline": "middle",
            "align": {
              "expr": "datum.lalign"
            },
            "dx": {
              "expr": "datum.ldx"
            },
            "dy": {
              "expr": "datum.ldy"
            }
          },
          "encoding": {
            "longitude": {
              "field": "plon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "plat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    },
