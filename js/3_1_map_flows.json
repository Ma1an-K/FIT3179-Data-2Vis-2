{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "From birthplace to the place the story is set", "subtitle": "One line per Best Film-winning director: where they were born → where their film takes place"},
  "width": "container",
  "height": 460,
  "background": "#D9E4EC",
  "params": [{"name": "decade", "value": "All"}],
  "projection": {"type": "equalEarth", "rotate": [-150, 0, 0]},
  "layer": [
    {"data": {"graticule": {"step": [30, 30]}}, "mark": {"type": "geoshape", "stroke": "#C9D5DE", "strokeWidth": 0.5, "fill": null}},
    {
      "data": {"url": "js/ne_110m_admin_0_countries.topojson", "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}},
      "mark": {"type": "geoshape", "fill": "#E5DED2", "stroke": "#D9D1C4", "strokeWidth": 0.5}
    },
    {
      "data": {"url": "data/flows.csv"},
      "transform": [
        {"filter": "decade == 'All' || floor(datum.year / 10) * 10 + 's' == decade"},
        {"calculate": "datum.birth_country == 'Australia' ? 'Australian-born' : 'Born overseas'", "as": "origin"}
      ],
      "mark": {"type": "rule", "strokeWidth": 1.4, "opacity": 0.7, "strokeCap": "round"},
      "encoding": {
        "longitude": {"field": "lon1", "type": "quantitative"},
        "latitude": {"field": "lat1", "type": "quantitative"},
        "longitude2": {"field": "lon2"},
        "latitude2": {"field": "lat2"},
        "color": {"field": "origin", "type": "nominal", "scale": {"domain": ["Australian-born", "Born overseas"], "range": ["#B8892A", "#2E2A26"]}, "legend": {"title": null, "orient": "bottom-right"}},
        "tooltip": [
          {"field": "director", "title": "Director"},
          {"field": "birthplace", "title": "Born in"},
          {"field": "film", "title": "Film"},
          {"field": "year", "title": "Year"},
          {"field": "setting", "title": "Story set in"}
        ]
      }
    },
    {
      "data": {"url": "data/flows.csv"},
      "transform": [
        {"filter": "decade == 'All' || floor(datum.year / 10) * 10 + 's' == decade"},
        {"calculate": "datum.birth_country == 'Australia' ? 'Australian-born' : 'Born overseas'", "as": "origin"}
      ],
      "mark": {"type": "circle", "size": 50, "opacity": 0.95, "stroke": "#FFFFFF", "strokeWidth": 0.5},
      "encoding": {
        "longitude": {"field": "lon1", "type": "quantitative"},
        "latitude": {"field": "lat1", "type": "quantitative"},
        "color": {"field": "origin", "type": "nominal", "scale": {"domain": ["Australian-born", "Born overseas"], "range": ["#B8892A", "#2E2A26"]}, "legend": null},
        "tooltip": [{"field": "director", "title": "Director"}, {"field": "birthplace", "title": "Born in"}]
      }
    }
  ]
}
