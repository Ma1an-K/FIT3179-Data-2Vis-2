{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Every winner on one reel, 1969–2025", "subtitle": "One wedge per Best Film winner, clockwise from 1969 at the top; the 1973 and 2014 ties are stacked"},
  "width": "container",
  "height": 520,
  "params": [{"name": "decade", "value": "All"}],
  "data": {"url": "data/best_film_winners.csv"},
  "transform": [
    {"filter": "datum.year != null"},
    {"calculate": "floor(datum.year / 10) * 10 + 's'", "as": "decade_label"},
    {"calculate": "datum.year >= 2011 ? 'AACTA (2011– )' : 'AFI (1969–2010)'", "as": "era"},
    {"calculate": "decade == 'All' || datum.decade_label == decade", "as": "in_lens"},
    {"window": [{"op": "rank", "as": "tie"}], "groupby": ["year"]},
    {"calculate": "(datum.year - 1969) * (2 * PI / 57)", "as": "theta"},
    {"calculate": "(datum.year - 1969 + 0.92) * (2 * PI / 57)", "as": "theta2"},
    {"calculate": "datum.tie == 1 ? 120 : 165", "as": "r_inner"},
    {"calculate": "datum.tie == 1 ? 160 : 205", "as": "r_outer"}
  ],
  "layer": [
    {
      "mark": {"type": "arc", "stroke": "#FFFFFF", "strokeWidth": 1},
      "encoding": {
        "theta": {"field": "theta", "type": "quantitative", "scale": {"domain": [0, 6.283185307]}},
        "theta2": {"field": "theta2"},
        "radius": {"field": "r_outer", "type": "quantitative", "scale": {"type": "linear", "domain": [0, 240], "range": [0, 240]}},
        "radius2": {"field": "r_inner"},
        "color": {"field": "era", "type": "nominal", "scale": {"domain": ["AFI (1969–2010)", "AACTA (2011– )"], "range": ["#2E2A26", "#B8892A"]}, "legend": {"title": "Awarding body", "orient": "top-right", "direction": "vertical"}},
        "opacity": {"condition": {"test": "datum.in_lens", "value": 0.95}, "value": 0.18},
        "tooltip": [{"field": "film", "title": "Film"}, {"field": "year", "title": "Year"}, {"field": "director", "title": "Director"}]
      }
    },
    {
      "transform": [{"filter": "datum.year % 10 == 0 && datum.year != 1970 || datum.year == 1969"}],
      "mark": {"type": "text", "fontSize": 12, "color": "#6B6257", "radiusOffset": 18},
      "encoding": {
        "theta": {"field": "theta", "type": "quantitative", "scale": {"domain": [0, 6.283185307]}},
        "radius": {"value": 205},
        "text": {"field": "year"}
      }
    },
    {
      "data": {"values": [{"t": "58 winners"}]},
      "mark": {"type": "text", "fontSize": 22, "font": "Fraunces", "fontWeight": 600, "color": "#1F1A15"},
      "encoding": {"text": {"field": "t"}}
    }
  ]
}
