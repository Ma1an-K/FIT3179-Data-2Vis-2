{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Drama dominates, but the winners drift",
    "subtitle": "Best Film winners by decade and Wikidata genre; a film with two genres counts in both rows"
  },
  "width": {
    "step": 92
  },
  "height": {
    "step": 34
  },
  "data": {
    "url": "data/best_film_genres.csv"
  },
  "transform": [
    {
      "calculate": "floor(datum.year / 10) * 10 + 's'",
      "as": "decade_label"
    },
    {
      "calculate": "datum.decade_label == '1960s' ? '1970s' : datum.decade_label",
      "as": "decade_bin"
    },
    {
      "aggregate": [
        {
          "op": "distinct",
          "field": "film",
          "as": "films"
        }
      ],
      "groupby": [
        "decade_bin",
        "genre_group"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "films",
          "as": "genre_total"
        }
      ],
      "groupby": [
        "genre_group"
      ]
    },
    {
      "calculate": "datum.genre_group == 'Other' ? -1 : datum.genre_total",
      "as": "sort_key"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "films",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              9
            ],
            "range": [
              "#F3EBE0",
              "#C7643F",
              "#5E2110"
            ]
          },
          "legend": {
            "title": "Films",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 180
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "films"
        },
        "color": {
          "condition": {
            "test": "datum.films >= 5",
            "value": "#FFFFFF"
          },
          "value": "#1E1A14"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.genre_group == 'Drama' && datum.decade_bin == '2020s'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 54,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#5E2110",
        "text": "← Drama in every decade"
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "decade_bin",
      "type": "ordinal",
      "axis": {
        "title": "Decade of the award (1969 counted with the 1970s)",
        "labelAngle": 0,
        "orient": "top"
      }
    },
    "y": {
      "field": "genre_group",
      "type": "nominal",
      "sort": {
        "field": "sort_key",
        "order": "descending"
      },
      "axis": {
        "title": "Genre (Wikidata)"
      }
    },
    "tooltip": [
      {
        "field": "decade_bin",
        "title": "Decade"
      },
      {
        "field": "genre_group",
        "title": "Genre"
      },
      {
        "field": "films",
        "title": "Winning films"
      }
    ]
  }
}
