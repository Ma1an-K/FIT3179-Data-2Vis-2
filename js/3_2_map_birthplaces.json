{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Where the directors were born", "subtitle": "One circle per birthplace; size = number of Best Film wins by directors born there"},
  "width": "container",
  "height": 440,
  "params": [{"name": "decade", "value": "All"}],
  "projection": {"type": "equalEarth", "rotate": [-150, 0, 0]},
  "layer": [
    {"data": {"sphere": true}, "mark": {"type": "geoshape", "fill": "#D9E4EC", "stroke": null}},
    {"data": {"graticule": {"step": [30, 30]}}, "mark": {"type": "geoshape", "stroke": "#C9D5DE", "strokeWidth": 0.5, "fill": null}},
    {
      "data": {"url": "js/ne_110m_admin_0_countries.topojson", "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}},
      "mark": {"type": "geoshape", "fill": "#E5DED2", "stroke": "#FFFFFF", "strokeWidth": 0.5}
    },
    {
      "data": {"url": "data/best_film_directors.csv"},
      "transform": [
        {"filter": "datum.lon != null && datum.lat != null"},
        {"filter": "decade == 'All' || floor(datum.year / 10) * 10 + 's' == decade"},
        {"calculate": "datum.birth_country == 'Australia' ? 'Born in Australia' : 'Born overseas'", "as": "origin"},
        {"aggregate": [{"op": "count", "as": "wins"}, {"op": "values", "as": "rows"}], "groupby": ["birthplace", "birth_country", "origin", "lon", "lat"]},
        {"calculate": "join(pluck(datum.rows, 'director'), ', ')", "as": "directors"}
      ],
      "mark": {"type": "circle", "opacity": 0.85, "stroke": "#FFFFFF", "strokeWidth": 0.8},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {"field": "wins", "type": "quantitative", "scale": {"domain": [1, 8], "range": [40, 700]}, "legend": {"title": "Best Film wins", "orient": "bottom-left", "values": [1, 2, 4, 8]}},
        "color": {"field": "origin", "type": "nominal", "scale": {"domain": ["Born in Australia", "Born overseas"], "range": ["#B8892A", "#2E2A26"]}, "legend": {"title": null, "orient": "bottom-right"}},
        "tooltip": [{"field": "birthplace", "title": "Birthplace"}, {"field": "birth_country", "title": "Country"}, {"field": "wins", "title": "Wins"}, {"field": "directors", "title": "Directors"}]
      }
    }
  ]
}
