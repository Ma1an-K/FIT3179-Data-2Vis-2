{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Who is on top each year",
    "subtitle": "States ranked by drama production spend, 1995/96 to 2024/25"
  },
  "width": "container",
  "height": 260,
  "padding": {
    "right": 70
  },
  "data": {
    "url": "data/spend_by_state_series.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year_start": "number",
        "spend_m": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.spend_m != null && !isNaN(datum.spend_m)"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "spend_m",
          "order": "descending"
        }
      ],
      "groupby": [
        "year_start"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "year_start",
          "type": "quantitative",
          "axis": {
            "title": "Financial year starting",
            "format": "d",
            "tickCount": 10,
            "grid": false
          },
          "scale": {
            "domain": [
              1995,
              2024
            ],
            "nice": false
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "axis": {
            "title": "Rank by spend",
            "tickCount": 6,
            "format": "d"
          },
          "scale": {
            "domain": [
              6.5,
              0.5
            ]
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "Qld",
              "Vic",
              "SA",
              "WA",
              "ACT/Tas/NT"
            ],
            "range": [
              "#B8892A",
              "#C0552F",
              "#6E8E6A",
              "#4F78A8",
              "#8E6393",
              "#9A8A5E"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.3
        }
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "state"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ]
    },
    {
      "mark": {
        "type": "circle",
        "size": 40,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "year_start",
          "type": "quantitative"
        },
        "y": {
          "field": "rank",
          "type": "quantitative"
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "Qld",
              "Vic",
              "SA",
              "WA",
              "ACT/Tas/NT"
            ],
            "range": [
              "#B8892A",
              "#C0552F",
              "#6E8E6A",
              "#4F78A8",
              "#8E6393",
              "#9A8A5E"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "year_label",
            "title": "Year"
          },
          {
            "field": "state"
          },
          {
            "field": "rank",
            "title": "Rank"
          },
          {
            "field": "spend_m",
            "title": "A$ million",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year_start == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "year_start",
          "type": "quantitative"
        },
        "y": {
          "field": "rank",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "Qld",
              "Vic",
              "SA",
              "WA",
              "ACT/Tas/NT"
            ],
            "range": [
              "#B8892A",
              "#C0552F",
              "#6E8E6A",
              "#4F78A8",
              "#8E6393",
              "#9A8A5E"
            ]
          },
          "legend": null
        }
      }
    }
  ]
}