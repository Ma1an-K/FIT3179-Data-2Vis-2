{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Thirty years of drama spend, state by state", "subtitle": "Drama production spend in Australia by state and territory, A$ million, 1995/96 to 2024/25 (Screen Australia)"},
  "width": "container",
  "height": 360,
  "data": {"url": "data/spend_by_state_series.csv", "format": {"type": "csv", "parse": {"year_start": "number", "spend_m": "number"}}},
  "transform": [{"filter": "datum.spend_m != null && !isNaN(datum.spend_m)"}],
  "mark": {"type": "area", "interpolate": "monotone", "stroke": "#FFFFFF", "strokeWidth": 0.6},
  "encoding": {
    "x": {"field": "year_start", "type": "quantitative", "axis": {"title": "Financial year starting", "format": "d", "tickCount": 10, "grid": false}, "scale": {"domain": [1995, 2024], "nice": false}},
    "y": {"field": "spend_m", "type": "quantitative", "aggregate": "sum", "stack": "center", "axis": null},
    "color": {"field": "state", "type": "nominal", "scale": {"domain": ["NSW", "Qld", "Vic", "SA", "WA", "ACT/Tas/NT"], "range": ["#B5431F", "#2F5D50", "#C08B26", "#3B6EA5", "#8C4A7A", "#7D7A3A"]}, "legend": {"title": null, "orient": "top-left", "direction": "horizontal"}},
    "tooltip": [{"field": "year_label", "title": "Year"}, {"field": "state", "title": "State"}, {"field": "spend_m", "title": "A$ million", "format": ",.0f"}]
  }
}
