{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "About a hundred minutes, give or take", "subtitle": "Runtime of each Best Film winner by decade; box = middle half, line = median"},
  "width": "container",
  "height": 320,
  "data": {"url": "data/best_film_facts.csv", "format": {"type": "csv", "parse": {"year": "number", "cast_size": "number", "runtime_min": "number"}}},
  "transform": [
    {"filter": "datum.runtime_min != null && datum.runtime_min > 0"},
    {"calculate": "floor(datum.year / 10) * 10 + 's'", "as": "decade_label"},
    {"calculate": "datum.decade_label == '1960s' ? '1970s' : datum.decade_label", "as": "decade_bin"}
  ],
  "layer": [
    {
      "mark": {"type": "boxplot", "extent": "min-max", "size": 36, "box": {"fill": "#EFE9DF", "stroke": "#B8892A", "strokeWidth": 1.5}, "median": {"stroke": "#B8892A", "strokeWidth": 2.5}, "rule": {"stroke": "#B5AC9E"}, "ticks": {"stroke": "#B5AC9E", "size": 14}},
      "encoding": {
        "x": {"field": "decade_bin", "type": "ordinal", "axis": {"title": "Decade of the award", "labelAngle": 0}},
        "y": {"field": "runtime_min", "type": "quantitative", "axis": {"title": "Runtime (minutes)"}, "scale": {"zero": false}}
      }
    },
    {
      "mark": {"type": "circle", "size": 40, "color": "#2E2A26", "opacity": 0.7},
      "encoding": {
        "x": {"field": "decade_bin", "type": "ordinal"},
        "y": {"field": "runtime_min", "type": "quantitative"},
        "tooltip": [{"field": "film"}, {"field": "year"}, {"field": "runtime_min", "title": "Minutes"}]
      }
    }
  ]
}
