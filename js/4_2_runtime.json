{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Winners have grown longer than the world's films",
    "subtitle": [
      "Ochre dots: each winner's runtime. Ochre line: trend through the winners.",
      "Green line: median runtime of all feature films released worldwide that year (IMDb)."
    ]
  },
  "width": "container",
  "height": 340,
  "params": [
    {
      "name": "decade",
      "value": "All"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {
        "domain": [
          1968,
          2026
        ]
      },
      "axis": {
        "title": "Year",
        "format": "d",
        "tickMinStep": 1
      }
    },
    "y": {
      "type": "quantitative",
      "scale": {
        "domain": [
          40,
          165
        ],
        "zero": false
      },
      "axis": {
        "title": "Runtime (minutes)"
      }
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/world_runtime_by_year.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "median_runtime": "number",
            "films": "number"
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "color": "#2F5D50",
            "strokeWidth": 2,
            "opacity": 0.9
          },
          "encoding": {
            "y": {
              "field": "median_runtime"
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "opacity": 0,
            "size": 60
          },
          "encoding": {
            "y": {
              "field": "median_runtime"
            },
            "tooltip": [
              {
                "field": "year",
                "title": "Year"
              },
              {
                "field": "median_runtime",
                "title": "World median (min)"
              },
              {
                "field": "films",
                "title": "Feature films",
                "format": ","
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year == 2025"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 8,
            "fontWeight": 600,
            "fontSize": 12,
            "color": "#2F5D50",
            "text": "World median"
          },
          "encoding": {
            "y": {
              "field": "median_runtime"
            }
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/best_film_facts.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "cast_size": "number",
            "runtime_min": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.runtime_min != null && datum.runtime_min > 0"
        },
        {
          "calculate": "floor(datum.year / 10) * 10 + 's'",
          "as": "decade_label"
        },
        {
          "calculate": "decade == 'All' || datum.decade_label == decade",
          "as": "in_lens"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "loess": "runtime_min",
              "on": "year",
              "bandwidth": 0.5
            }
          ],
          "layer": [
            {
              "mark": {
                "type": "line",
                "color": "#B5431F",
                "strokeWidth": 2.5
              },
              "encoding": {
                "y": {
                  "field": "runtime_min"
                }
              }
            },
            {
              "transform": [
                {
                  "joinaggregate": [
                    {
                      "op": "max",
                      "field": "year",
                      "as": "last"
                    }
                  ]
                },
                {
                  "filter": "datum.year == datum.last"
                }
              ],
              "mark": {
                "type": "text",
                "align": "left",
                "dx": 8,
                "fontWeight": 600,
                "fontSize": 12,
                "color": "#B5431F",
                "text": "Best Film trend"
              },
              "encoding": {
                "y": {
                  "field": "runtime_min"
                }
              }
            }
          ]
        },
        {
          "mark": {
            "type": "circle",
            "size": 55,
            "color": "#B5431F",
            "stroke": "#FFFFFF",
            "strokeWidth": 1
          },
          "encoding": {
            "y": {
              "field": "runtime_min"
            },
            "opacity": {
              "condition": {
                "test": "datum.in_lens",
                "value": 1
              },
              "value": 0.25
            },
            "tooltip": [
              {
                "field": "film",
                "title": "Film"
              },
              {
                "field": "year",
                "title": "Year"
              },
              {
                "field": "runtime_min",
                "title": "Minutes"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.film == 'Elvis'"
            },
            {
              "calculate": "datum.film + ', ' + datum.runtime_min + ' min'",
              "as": "note"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 11,
            "color": "#5E2110",
            "align": "right",
            "dx": -8
          },
          "encoding": {
            "y": {
              "field": "runtime_min"
            },
            "text": {
              "field": "note"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.film == 'Homesdale'"
            },
            {
              "calculate": "datum.film + ', ' + datum.runtime_min + ' min'",
              "as": "note"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 11,
            "color": "#5E2110",
            "align": "left",
            "dx": 8
          },
          "encoding": {
            "y": {
              "field": "runtime_min"
            },
            "text": {
              "field": "note"
            }
          }
        }
      ]
    }
  ]
}
